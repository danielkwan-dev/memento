# Worker: claims scrape jobs and runs the pipeline. No frontend, so no node stage.
#
# It also serves a health endpoint, which is what makes it wakeable: on a free
# tier an idle service is stopped, and an inbound HTTP request is what starts it.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/

ENV CGO_ENABLED=0 GOOS=linux
RUN go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -u 10001 app
COPY --from=build /out/worker /usr/local/bin/worker
USER app
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/worker"]
