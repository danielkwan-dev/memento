MEMENTO_DATABASE_URL=postgres://memento:memento@localhost:5432/memento?sslmode=disable
MEMENTO_PORT=8080
MEMENTO_WORKER_PORT=8081
MEMENTO_WORKER_HEALTH_URL=http://localhost:8081/healthz
MEMENTO_CORS_ORIGINS=http://localhost:5173
# Concurrency: user grid/diary pages are NOT edge-cached -> keep low.
MEMENTO_INDEX_CONCURRENCY=3
# Film detail pages sit in Cloudflare's edge cache and tolerate parallelism:
# measured, 12 films at concurrency 16 complete in ~281ms with zero blocks.
# Cloudflare's real limit here is per-IP and cumulative over a long scrape, so the
# interval spends that budget more slowly rather than preventing a block outright.
MEMENTO_DETAIL_CONCURRENCY=12
MEMENTO_DETAIL_INTERVAL_MS=120
MEMENTO_INDEX_INTERVAL_MS=1500
MEMENTO_DETAILS_TTL=2160h
MEMENTO_STATS_TTL=168h
